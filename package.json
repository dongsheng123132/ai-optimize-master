{
  "name": "ai-optimize-master",
  "version": "0.3.0",
  "description": "AI 优化大师 — audit duplicate, broken and stale AI-tool skills and MCP declarations, propose improvements, and archive selected items with a hash-bound plan and byte-exact undo. Read-only by default.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".\"": "./index.js",
    "./scan": "./lib/scan.mjs",
    "./plan": "./lib/apply.mjs",
    "./evolve": "./lib/evolve.mjs",
    "./util": "./lib/util.mjs"
  },
  "bin": {
    "ai-optimize-master": "./bin/dsh-optimizer.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "index.js",
    "lib/",
    "bin/",
    "skill/",
    "cordis.patch.yml",
    "mcp-server.mjs",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2-alpha.4",
      "node": ">=22",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:plugin": "node test/plugin-smoke.mjs",
    "smoke:mcp": "node test/mcp-smoke.mjs",
    "evolve": "node bin/dsh-optimizer.mjs evolve"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongsheng123132/ai-optimize-master.git"
  },
  "keywords": [
    "ai-optimize-master",
    "ai-optimizer",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill-management",
    "mcp",
    "cleanup",
    "inventory"
  ],
  "homepage": "https://github.com/dongsheng123132/ai-optimize-master#readme"
}
